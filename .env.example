# Copy to .env and fill in your own values.

# --- Penyimpanan: EdgeOne Blob (wajib) --------------------------------------
# Seluruh state aplikasi — akun, sesi, hasil kuis, rekomendasi — ada di
# EdgeOne Pages Blob. Tidak ada database SQL.
#
# Di dalam EdgeOne Makers kredensialnya DISUNTIK PLATFORM saat build, jadi
# tidak ada satu pun variabel di bagian ini yang perlu diisi saat terdeploy.
# Bagian ini hanya untuk menjalankan aplikasi DI LUAR platform.
#
# Pilih SALAH SATU:
#
#   1. Dev lokal tanpa kredensial — data disimpan sebagai berkas biasa.
#      Ini yang dipakai `npm run test:auth`, dan paling cepat untuk mulai.
BLOB_LOCAL_DIR=./.blob-data
#
#   2. Menunjuk Blob sungguhan dari mesin Anda (mis. untuk `npm run seed`
#      terhadap project produksi). Token dibuat di konsol Makers →
#      Project Settings → API Token. Isi keduanya, lalu kosongkan
#      BLOB_LOCAL_DIR di atas — kalau keduanya terisi, token yang menang.
# EDGEONE_PROJECT_ID=makers-xxxxxxxxxxxx
# EDGEONE_BLOB_TOKEN=

# Nama namespace Blob. Hanya huruf/angka/garis bawah/tanda hubung, maks 64.
# BLOB_STORE_NAME=auditor

# --- LLM: DeepSeek lewat AI Gateway Makers (wajib untuk fitur AI) -----------
# Dipakai untuk generator kuis DAN halaman rekomendasi. Gateway-nya
# OpenAI-compatible dan menyediakan model DeepSeek bawaan, jadi tidak perlu
# akun DeepSeek sendiri. Ambil kunci di konsol Makers → Models → API Key.
MAKERS_MODELS_KEY=
MAKERS_MODEL=@makers/deepseek-v4-flash

PORT=3000

# Kata sandi awal untuk akun staf bawaan (admin/auditor/director @company.co.id).
# Hanya dipakai sekali, saat store pertama kali diisi. Default: Auditor#2026 —
# ganti sebelum seed pertama, lalu ubah lewat tab Akun di aplikasi.
SEED_PASSWORD=Auditor#2026

# Atribut Secure pada cookie sesi. Kosongkan untuk deteksi otomatis (disarankan):
# HTTPS terdeteksi dari X-Forwarded-Proto milik reverse proxy atau koneksi TLS
# langsung; di http://localhost atribut tidak dipasang agar login lokal jalan.
#   1 = selalu pasang Secure   ·   0 = jangan pernah pasang
# COOKIE_SECURE=1

# Umur cache dalam proses untuk agregat analitik (ms). Mode Agent EdgeOne
# menahan instance antar-request, jadi cache ini benar-benar mengurangi
# jumlah objek yang dibaca dari Blob. Naikkan bila analitik terasa lambat.
# BLOB_CACHE_TTL_MS=15000
