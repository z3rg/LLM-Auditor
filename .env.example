# Copy to .env and fill in your own key.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
PORT=3000

# Kata sandi awal untuk akun staf bawaan (admin/auditor/director @company.co.id).
# Hanya dipakai sekali, saat server pertama kali dijalankan pada database baru.
# Default bila tidak diisi: Auditor#2026 — ganti sebelum run pertama, lalu ubah
# kata sandi lewat tab Akun di aplikasi.
SEED_PASSWORD=Auditor#2026

# (Opsional) path ekstensi sqlite-vec untuk RAG. Default: lib/vendor/vec0.dylib
# Bila file tidak ada / gagal dimuat, app otomatis memakai fallback cosine JS.
# SQLITE_VEC_PATH=/path/to/vec0.dylib

# Embedding RAG — Gemini only.
#   Backend embedding satu-satunya adalah Google Gemini (gemini-embedding-001, 3072-dim).
#   Butuh GEMINI_API_KEY. Tidak ada fallback lokal/leksikal.
#   Skrip Python scripts/ingest_legal_pdf.py memakai model & dimensi yang sama.
#
#   GEMINI_API_KEY     : kunci Google AI — wajib. Ambil di https://aistudio.google.com/apikey
#   GEMINI_EMBED_MODEL : default gemini-embedding-001
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBED_MODEL=gemini-embedding-001
