# Copy to .env and fill in your own values.

# --- Database (wajib) -------------------------------------------------------
# Postgres + pgvector. Driver yang dipakai berbicara lewat endpoint HTTP Neon,
# jadi ini harus connection string Neon (…neon.tech) — bukan Postgres lokal.
# Buat gratis di https://neon.tech, lalu jalankan sekali: npm run db:setup
DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Branch Neon terpisah khusus `npm run test:auth`. Uji regresi MENGOSONGKAN
# seluruh tabel di database ini, jadi jangan pernah arahkan ke DATABASE_URL.
# TEST_DATABASE_URL=

# --- LLM (fitur AI: rekomendasi, SQL Agent, generator kuis) -----------------
# Provider default: AI Gateway EdgeOne Makers (OpenAI-compatible).
# Ambil kunci di konsol Makers → Models → API Key.
MAKERS_MODELS_KEY=
MAKERS_MODEL=@makers/deepseek-v4-flash

# Jalur alternatif. Dipakai otomatis bila MAKERS_MODELS_KEY kosong, atau paksa
# dengan AI_PROVIDER=groq. Skemanya identik — hanya base URL, kunci, dan id
# model yang berbeda. Key gratis: https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Kosongkan untuk pemilihan otomatis; isi 'makers' atau 'groq' untuk memaksa.
# AI_PROVIDER=

PORT=3000

# Kata sandi awal untuk akun staf bawaan (admin/auditor/director @company.co.id).
# Hanya dipakai sekali, saat server pertama kali dijalankan pada database baru.
# Default bila tidak diisi: Auditor#2026 — ganti sebelum run pertama, lalu ubah
# kata sandi lewat tab Akun di aplikasi.
SEED_PASSWORD=Auditor#2026

# Atribut Secure pada cookie sesi. Kosongkan untuk deteksi otomatis (disarankan):
# HTTPS terdeteksi dari X-Forwarded-Proto milik reverse proxy atau koneksi TLS
# langsung; di http://localhost atribut tidak dipasang agar login lokal jalan.
#   1 = selalu pasang Secure   ·   0 = jangan pernah pasang
# COOKIE_SECURE=1

# Embedding RAG — Gemini only.
#   AI Gateway Makers hanya melayani chat completion, tidak ada endpoint
#   embeddings, jadi bagian ini TETAP di Gemini.
#   Backend embedding satu-satunya adalah Google Gemini (gemini-embedding-001, 3072-dim).
#   Butuh GEMINI_API_KEY. Tidak ada fallback lokal/leksikal.
#   Vektor disimpan di kolom pgvector vector(3072); skrip Python
#   scripts/ingest_legal_pdf.py memakai model, dimensi, dan database yang sama.
#
#   GEMINI_API_KEY     : kunci Google AI — wajib. Ambil di https://aistudio.google.com/apikey
#   GEMINI_EMBED_MODEL : default gemini-embedding-001
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBED_MODEL=gemini-embedding-001
