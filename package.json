{
  "name": "llm-auditor",
  "version": "1.0.0",
  "description": "IT Auditor quiz analytics with Groq AI: knowledge-gap recommendations, quiz topic suggestions, and a Super Admin -> SQL Agent -> Director acknowledgement workflow.",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "seed": "node -e \"require('./lib/db').reseed(); console.log('Database reseeded.')\"",
    "ingest-legal": "python3 scripts/ingest_legal_pdf.py",
    "docker:build": "docker build -f docker/Dockerfile -t llm-auditor .",
    "docker:run": "docker run --rm -p 3000:3000 --env-file .env -v auditor-data:/app/data llm-auditor",
    "docker:up": "docker compose -f docker/docker-compose.yml --env-file .env up --build -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "it-audit",
    "groq",
    "llm",
    "sql-agent",
    "quiz",
    "knowledge-gap",
    "rag",
    "sqlite-vec",
    "react",
    "embeddings"
  ],
  "license": "MIT",
  "//": "Inti app zero-dependency. Embedding RAG memakai Gemini API (gemini-embedding-001) — butuh GEMINI_API_KEY, tanpa dependency npm tambahan."
}
