# Ignore-file khusus Dockerfile ini — BuildKit otomatis memakai
# "<dockerfile>.dockerignore" (docker/Dockerfile.dockerignore). Pola di bawah
# relatif terhadap KONTEKS build (root repo), bukan folder docker/.

# Cache & dependency — node_modules dipasang di dalam image (npm ci)
node_modules/
.npm-cache/
.cache/
.venv/

# Snapshot SQLite lama (hanya sumber migrasi) & rahasia — JANGAN masuk image
data/
*.db
*.db-wal
*.db-shm
*.db-journal
.env

# Git & misc
.git/
.gitignore
.DS_Store
npm-debug.log*
*.log

# Dokumen tidak diperlukan saat runtime
*.md
