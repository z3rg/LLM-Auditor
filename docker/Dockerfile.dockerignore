# Ignore-file khusus Dockerfile ini — BuildKit otomatis memakai
# "<dockerfile>.dockerignore" (docker/Dockerfile.dockerignore). Pola di bawah
# relatif terhadap KONTEKS build (root repo), bukan folder docker/.

# Cache & dependency (app zero-dependency; tidak ada yang perlu disalin)
node_modules/
.npm-cache/
.cache/
.venv/

# Data runtime lokal & rahasia — JANGAN dibungkus ke image
data/
*.db
*.db-wal
*.db-shm
*.db-journal
.env

# Biner vendor lokal (macOS .dylib) — image mengunduh vec0.so untuk Linux
lib/vendor/

# Git & misc
.git/
.gitignore
.DS_Store
npm-debug.log*
*.log

# Dokumen tidak diperlukan saat runtime
*.md
