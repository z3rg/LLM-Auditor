# Salin ke deploy/tencent/.env DI SERVER, lalu isi nilainya. Jangan commit file .env.
#   cp env.production.example .env && nano .env && chmod 600 .env

# --- Database (wajib) -------------------------------------------------------
# Postgres + pgvector di Neon. Skema disiapkan sekali dari mesin Anda:
#   DATABASE_URL='…' npm run db:setup
DATABASE_URL=

# --- Kunci API (wajib) ------------------------------------------------------
# Groq: fitur AI (rekomendasi, SQL Agent, generator kuis) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini: embedding RAG / impor PDF — https://aistudio.google.com/apikey
# Tanpa key ini app tetap jalan, tapi impor PDF & retrieval RAG nonaktif.
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- Akun staf bawaan -------------------------------------------------------
# WAJIB diisi SEBELUM `up` yang pertama. Dipakai sekali saat database kosong
# dibuat, untuk akun admin/auditor/director @company.co.id. Kalau dikosongkan,
# app memakai default publik "Auditor#2026" — jangan sampai itu terjadi di
# instance yang terbuka ke internet.
SEED_PASSWORD=

# --- Jaringan ---------------------------------------------------------------
# Port publik di instance. 80 = http://IP tanpa nomor port.
PUBLIC_PORT=80

# Atribut Secure pada cookie sesi. Biarkan kosong (deteksi otomatis) selama
# akses masih lewat http://IP — memaksa COOKIE_SECURE=1 tanpa HTTPS membuat
# browser membuang cookie dan login selalu gagal.
# Isi 1 nanti setelah domain + TLS terpasang.
# COOKIE_SECURE=
