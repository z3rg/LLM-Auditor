# Dependencies (app inti zero-dependency; abaikan bila ada tooling Node lokal)
node_modules/
.npm-cache/
.cache/

# Python (skrip ingest scripts/ingest_legal_pdf.py) — virtualenv & bytecode
.venv/
__pycache__/

# Database runtime. Berkas WAL/SHM bersifat sementara — jangan pernah dilacak.
data/*
*.db
*.db-journal
*.db-wal
*.db-shm
# Kecuali snapshot demo: sengaja dilacak agar repo bisa langsung dijalankan
# lengkap dengan data kuis + indeks RAG. Lihat catatan di README.
!data/auditor.db

# Secrets & OS
.env
.DS_Store
*.log
npm-debug.log*

# Media & dokumen presentasi — disimpan lokal saja, tidak ikut ke repo.
# Dek dokumentasi (.pptx/.pdf) dipelihara di luar git; dokumentasi.md yang
# menjadi rujukan tertulis di repo.
*.mp4
*.pptx
*.pdf
